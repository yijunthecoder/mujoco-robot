<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>build_a_zebra</name>
  <version>0.1.0</version>
  <description>
    Behavior Tree + World Model brain for the "Build the Zebra" assembly
    task. Tracks Head/Body/Feet state (located, lost, picked, placed) and
    selects the next action, reacting to simulated relocation, loss, and
    failed-pick events.
  </description>
  <maintainer email="victortjx05.24@ichat.sp.edu.sg">Victor</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ament_index_cpp</depend>
  <!-- nlohmann/json is used via a plain #include (header-only), so no
       ROS package dependency is declared for it. Just make sure
       nlohmann-json3-dev is installed on your system via apt. -->
  <!-- BehaviorTree.CPP v4. If it's not already on your system:
       sudo apt install ros-humble-behaviortree-cpp -->
  <depend>behaviortree_cpp</depend>

  <!-- Lint disabled; see CMakeLists.txt for the reason.
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  -->
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>