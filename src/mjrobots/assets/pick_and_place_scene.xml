       Lives next to panda.xml because MuJoCo resolves an included file's relative
       asset paths (meshdir="assets") against the TOP-LEVEL scene file's directory,
       not the included file's own directory. -->
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
