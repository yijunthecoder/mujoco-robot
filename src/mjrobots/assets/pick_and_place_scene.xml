  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.55 0.4 0.28 1"/>
    <material name="cube_mat" rgba="0.1 0.8 0.2 1"/>
    <material name="target_mat" rgba="1 0 0 0.35"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="table" pos="0.5 0.3 0.175">
      <geom name="table_top" type="box" size="0.15 0.15 0.175" material="table_mat"/>
    </body>

    <body name="place_marker" pos="0.5 0.3 0.3505">
      <geom name="place_marker_geom" type="cylinder" size="0.04 0.0005" material="target_mat"
        contype="0" conaffinity="0"/>
    </body>

    <body name="cube" pos="0.5 -0.25 0.03">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.02 0.02 0.03" condim="4" friction="1.2 0.05 0.002"
        material="cube_mat" mass="0.05"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="pick_place_start"
      qpos="0 0 0 -1.57079 0 1.57079 -0.7853 0.04 0.04 0.5 -0.25 0.03 1 0 0 0"
      ctrl="0 0 0 -1.57079 0 1.57079 -0.7853 255"/>
  </keyframe>
</mujoco>
